# dependencies
node_modules/

# build output
dist/
build/
.turbo/
*.tsbuildinfo

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env (nunca versionar segredos; .env.example fica de fora desta regra)
.env
.env.local
.env.*.local

# uploads (mantém a pasta no git, ignora o conteúdo)
apps/server/uploads/*
!apps/server/uploads/.gitkeep

# expo / react native (regras específicas do app em apps/mobile/.gitignore)
.expo/
.expo-shared/
web-build/

# editor / os
.vscode/*
!.vscode/extensions.json
.idea/
*.code-workspace
.DS_Store
Thumbs.db

# testes
coverage/
