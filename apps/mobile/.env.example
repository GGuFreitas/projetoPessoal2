# Copie para ".env" e ajuste se necessário.
# Variáveis prefixadas com EXPO_PUBLIC_ são embutidas no bundle pelo próprio Expo
# (não precisa de lib extra tipo react-native-dotenv).

# No emulador Android use http://10.0.2.2:3333 em vez de localhost.
# No celular físico (Expo Go), use o IP da sua máquina na rede local, ex: http://192.168.0.10:3333
EXPO_PUBLIC_API_URL=http://localhost:3333
