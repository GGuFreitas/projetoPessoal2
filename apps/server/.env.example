# Copie este arquivo para ".env" e ajuste os valores.

NODE_ENV=development
PORT=3333

# Deve bater com o docker-compose.yml (usuário/senha/db "organizalar")
DATABASE_URL=postgres://organizalar:organizalar@localhost:5432/organizalar

REDIS_URL=redis://localhost:6379

# Gere um valor aleatório longo, ex: openssl rand -hex 32
JWT_SECRET=troque-por-uma-string-aleatoria-de-pelo-menos-32-caracteres

UPLOAD_DIR=./uploads

# Token do bot criado via @BotFather no Telegram (ver README > "Configurando o Telegram")
TELEGRAM_BOT_TOKEN=
